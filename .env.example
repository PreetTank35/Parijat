# ============================================
# PARIJAT — Environment Configuration
# ============================================
# Copy this file to .env and customize values.

# Database (PostgreSQL)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://parijat:parijat123@localhost:5432/parijat?schema=public"

# Server
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# Frontend
VITE_API_URL=http://localhost:3001/api/v1

# Auth
JWT_SECRET=parijat-dev-secret-change-in-production-2024
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
DEMO_MODE=true

# Demo OTP (development only — never enable in production)
DEMO_OTP_CODE=123456

# Location defaults (Pune district pilot)           
DEFAULT_SEARCH_RADIUS_KM=25
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567
